# Env for `docker compose --env-file .env.docker up` — the fully-local stack
# (Postgres, Auth, Weaviate + local embeddings). This is separate from your
# regular .env so the Docker workflow never touches your cloud setup.
#   cp .env.docker.example .env.docker

# Postgres superuser password — shared by Prisma and GoTrue's internal role.
# Any string is fine for local use.
POSTGRES_PASSWORD="change-me-locally"

# Signs/verifies the local Auth tokens. Pre-generated so ANON_KEY below is
# already valid for this secret — regenerate both together if you change this.
JWT_SECRET="c635eed62d27a1d5c8598dc7e6f28765268fc5e272734f0af053bd9bd734d1f8"
ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6Im5vbmFraS1sb2NhbCIsImlhdCI6MTc5ODc2MTYwMCwiZXhwIjoyMTE0MTIxNjAwfQ.JF5qUbELxQPqS8eDlswyGuxyYrsr3X12TbyLG5TE5X0"

# At least one of these is required — this is the one call that still leaves
# the Docker network (see README → "Run fully locally with Docker").
GROQ_API_KEY=""
GROQ_MODEL=""
OPENAI_API_KEY=""
OPENAI_MODEL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL=""

# Optional — see DATA_SOURCE_DISABLED in .env.example.
DATA_SOURCE_DISABLED="false"
