{
  "recipe": 1,
  "name": "WP Simple Pay Pro",
  "brand": {
    "name": "WP Simple Pay",
    "mark": "M2.352 0C1.052 0 0 1.02 0 2.277v30.746C0 34.281 1.053 35.3 2.352 35.3h28.806c.975 0 1.764-.764 1.764-1.708 0-.943-.79-1.708-1.763-1.708H5.29c-.974 0-1.764-.765-1.764-1.708v-17.08c0-.944.79-1.709 1.764-1.709h44.092c1.299 0 2.352-1.02 2.352-2.277V2.277C51.735 1.02 50.682 0 49.383 0H2.352Zm55.262 24.198h-1.47v-1.993c0-4.088-3.422-7.402-7.643-7.402-4.22 0-7.642 3.314-7.642 7.402v1.993H38.8c-1.299 0-2.352 1.02-2.352 2.277v11.387c0 1.258 1.053 2.278 2.352 2.278h18.813c1.299 0 2.351-1.02 2.351-2.278V26.475c0-1.258-1.053-2.277-2.351-2.277Zm-4.997-1.993v1.993h-8.23v-1.993c0-2.201 1.842-3.985 4.114-3.985 2.273 0 4.116 1.784 4.116 3.985ZM8.23 20.497c0-.629.526-1.139 1.175-1.139H28.22c.65 0 1.176.51 1.176 1.139s-.527 1.139-1.176 1.139H9.406c-.649 0-1.175-.51-1.175-1.139Zm0 5.124c0-.629.526-1.138 1.175-1.138h7.055c.65 0 1.176.51 1.176 1.138 0 .63-.527 1.139-1.176 1.139H9.406c-.649 0-1.175-.51-1.175-1.139Zm31.158 11.672V27.045h17.637v10.248H39.389Z"
  },
  "consoleState": "tools/release-console",
  "vars": {
    "litePath": "{settings.liteRepoPath}",
    "svnPath": {
      "if": "env.SVN_WC",
      "then": "{env.SVN_WC}",
      "else": "{repoParent}/stripe-svn"
    }
  },
  "version": {
    "pattern": "^(?<base>\\d+\\.\\d+\\.\\d+)(?<hotfix>\\.\\d+)?$",
    "hint": "A version like 4.17.5, or a 4-part hotfix like 4.17.4.1",
    "vars": {
      "releaseDir": "docs/releases/{base}",
      "analysisFile": {
        "if": "hotfix",
        "then": "{releaseDir}/{version}.md",
        "else": "{releaseDir}/release.md"
      },
      "siteChangesFile": {
        "if": "hotfix",
        "then": "{releaseDir}/marketing-site-changes-{version}.md",
        "else": "{releaseDir}/marketing-site-changes.md"
      }
    }
  },
  "settings": {
    "file": ".claude/release.config.json",
    "fields": {
      "marketingSitePath": {
        "label": "Marketing site docs plugin",
        "help": "The wpsp-docs plugin folder. The Docs stage copies articles here and syncs them.",
        "type": "path",
        "validate": [
          {
            "rule": "required",
            "level": "warning",
            "message": "No marketing site set. The Docs stage cannot sync docs to wpsimplepay.com until it is."
          },
          {
            "rule": "isDirectory",
            "level": "error",
            "message": "The marketing site folder {value} does not exist."
          },
          {
            "rule": "contains",
            "paths": [
              "docs-user",
              "package.json"
            ],
            "level": "error",
            "message": "{value} does not look like the wpsp-docs plugin (no docs-user/ folder or package.json)."
          }
        ]
      },
      "liteRepoPath": {
        "label": "Lite checkout",
        "help": "Leave empty to use the default next to this checkout. The Lite commands clone it there on first use.",
        "type": "path",
        "default": "{repoParent}/wp-simple-pay-lite",
        "env": "LITE_REPO",
        "validate": [
          {
            "rule": "notSamePath",
            "path": "{repo}",
            "level": "error",
            "message": "The Lite path points at this Pro checkout. Lite must be a separate folder."
          },
          {
            "rule": "isDirectory",
            "level": "warning",
            "message": "No Lite checkout at {value} yet. The Lite commands clone it there on first use."
          },
          {
            "rule": "contains",
            "paths": [
              "stripe-checkout.php"
            ],
            "level": "error",
            "message": "{value} is not a Lite checkout (no stripe-checkout.php)."
          }
        ]
      }
    }
  },
  "groups": [
    {
      "id": "qa",
      "label": "Quality checks"
    },
    {
      "id": "prepare",
      "label": "Prepare release"
    },
    {
      "id": "publish",
      "label": "Preview content"
    },
    {
      "id": "ship",
      "label": "Release"
    }
  ],
  "stages": [
    {
      "id": "review-milestone",
      "group": "qa",
      "title": "Review milestone PRs",
      "prompt": "/wpsp-review-milestone {version}",
      "summary": "Reviews every open PR in the milestone (one subagent per PR), audits the milestone’s issues, and writes a review file per PR plus an index.",
      "requires": [
        "gh"
      ],
      "doneWhen": {
        "fileExists": "docs/releases/{version}/reviews/README.md"
      },
      "review": {
        "type": "file",
        "path": "docs/releases/{version}/reviews/README.md",
        "label": "Open review index"
      }
    },
    {
      "id": "compare-builds",
      "group": "qa",
      "title": "Compare build with last release",
      "prompt": "/wpsp-compare-builds {version}",
      "summary": "Compares the Pro and Lite zips with the last release, to catch missing assets and stray files before shipping. Uses the release branch’s CI build, or a local build from the Builds page.",
      "gates": [
        "Compare a stale build, or dispatch a fresh one (CI build only)"
      ],
      "requires": [
        "gh"
      ],
      "doneWhen": {
        "fileExists": "build-audit/reports/{version}-build-diff.md"
      },
      "localBuild": {
        "requireArtifact": "pro",
        "args": [
          "--candidate {build.artifact.pro}",
          {
            "if": "build.artifact.lite",
            "then": "--lite-candidate {build.artifact.lite}",
            "else": "--pro-only"
          },
          {
            "if": "build.commit",
            "then": "--candidate-commit {build.commit}"
          },
          {
            "if": "build.changes",
            "then": "--candidate-uncommitted {build.changes}"
          }
        ]
      }
    },
    {
      "id": "analyze",
      "group": "prepare",
      "title": "Draft changelog & analysis",
      "prompt": "/wpsp-analyze-release {version}",
      "summary": "Reads every change since the last tag and writes the release analysis, changelog draft and PR body. Also updates docs/PRODUCT.md.",
      "requires": [
        "gh"
      ],
      "doneWhen": {
        "fileExists": "{analysisFile}"
      },
      "review": {
        "type": "file",
        "path": "{analysisFile}",
        "label": "Review analysis"
      }
    },
    {
      "id": "prep",
      "group": "prepare",
      "title": "Bump version & changelog",
      "prompt": "/wpsp-prep-release {version}",
      "summary": "Checks out the release branch, bumps the version, writes the changelog into both readmes, replaces {next} tags and writes the marketing site changes report.",
      "gates": [
        "Approve or edit the changelog entries"
      ],
      "blockedUntil": [
        {
          "check": {
            "fileExists": "{analysisFile}"
          },
          "reason": "Run Draft changelog & analysis first. {analysisFile} does not exist yet."
        }
      ],
      "doneWhen": {
        "all": [
          {
            "fileMatches": "simple-pay.php",
            "regex": "^\\s*\\*?\\s*Version:\\s*{version}\\s*$"
          },
          {
            "fileMatches": "simple-pay.php",
            "regex": "define\\(\\s*'SIMPLE_PAY_VERSION',\\s*'{version}'\\s*\\)"
          },
          {
            "fileExists": "{siteChangesFile}"
          }
        ]
      },
      "review": {
        "type": "changes",
        "label": "Review changes"
      }
    },
    {
      "id": "docs",
      "group": "prepare",
      "title": "Update customer docs",
      "prompt": "/wpsp-update-docs {version}",
      "summary": "Updates the customer docs in docs-user/ for this release, captures screenshots and syncs the docs to the marketing site.",
      "gates": [
        "Confirm the scope of changes",
        "Approve the plan of articles to add or update",
        "Start the marketing site in Local if it is stopped"
      ],
      "requires": [
        "local-wp"
      ],
      "blockedUntil": [
        {
          "check": {
            "fileExists": "{analysisFile}"
          },
          "reason": "Run Draft changelog & analysis first. {analysisFile} does not exist yet."
        }
      ],
      "review": {
        "type": "docs",
        "label": "Review docs"
      }
    },
    {
      "id": "docs-site-pr",
      "group": "prepare",
      "title": "Open docs PR on marketing site",
      "prompt": "/wpsp-docs-site-pr {version}",
      "summary": "After Update customer docs: clones the marketing site repo into a temporary folder, copies docs-user/ into plugins/wpsp-docs/docs-user/ while keeping the site’s published slugs, opens the sync PR and removes the temporary folder.",
      "gates": [
        "Approve any deleted articles or broken URLs",
        "Confirm the PR before it is pushed and opened"
      ],
      "requires": [
        "gh"
      ],
      "blockedUntil": [
        {
          "check": {
            "fileExists": "{analysisFile}"
          },
          "reason": "Run Draft changelog & analysis first. {analysisFile} does not exist yet."
        }
      ],
      "status": "wpsp-pro.hooks.mjs#docsSitePr"
    },
    {
      "id": "marketing",
      "group": "prepare",
      "title": "Write marketing content",
      "prompt": "/wpsp-marketing-all {version}",
      "summary": "Writes the blog post first, then the featured image (generated in Chatty through your Chrome), newsletter, social posts, Slack posts and in-plugin notifications in parallel.",
      "gates": [
        "Pick the blog title and approve the section plan",
        "Sign in to Chatty in Chrome if needed (for the featured image)"
      ],
      "requires": [
        "browser"
      ],
      "blockedUntil": [
        {
          "check": {
            "fileExists": "{analysisFile}"
          },
          "reason": "Run Draft changelog & analysis first. {analysisFile} does not exist yet."
        }
      ],
      "doneWhen": {
        "all": [
          {
            "fileExists": "{releaseDir}/blog.html"
          },
          {
            "fileExists": "{releaseDir}/blog-{version}-featured-image.jpg"
          },
          {
            "fileExists": "{releaseDir}/newsletter.html"
          },
          {
            "fileExists": "{releaseDir}/twitter.txt"
          },
          {
            "fileExists": "{releaseDir}/linkedin.txt"
          },
          {
            "fileExists": "{releaseDir}/slack-pro.txt"
          },
          {
            "fileExists": "{releaseDir}/slack-lite.txt"
          },
          {
            "fileExists": "{releaseDir}/notification-pro.html"
          },
          {
            "fileExists": "{releaseDir}/notification-lite.html"
          }
        ]
      },
      "listMissing": true,
      "review": {
        "type": "files",
        "label": "View assets"
      }
    },
    {
      "id": "marketing-review",
      "group": "prepare",
      "title": "Check marketing content",
      "prompt": "Check marketing content {version}",
      "summary": "Checks everything Write marketing content made before any of it goes out. Fixed checks run first: files, version, placeholders, merge tags, lengths, link tracking, images and dead links. Then a read-only Claude Code session reads it all against the release notes and each piece's own house rules. Blockers must be fixed; warnings fixed or dismissed with a reason. The blog, email and notification drafts wait until it passes.",
      "contentReview": true,
      "blockedUntil": [
        {
          "check": {
            "any": [
              {
                "fileExists": "{releaseDir}/blog.html"
              },
              {
                "fileExists": "{releaseDir}/newsletter.html"
              }
            ]
          },
          "reason": "Run Write marketing content first. There is no blog post or newsletter to check yet."
        }
      ],
      "doneWhen": {
        "contentReview": "passed"
      },
      "review": {
        "type": "contentReview",
        "label": "Findings"
      }
    },
    {
      "id": "blog-draft",
      "group": "publish",
      "title": "Create blog post draft",
      "prompt": "/wpsp-publish-blog-post {version}",
      "summary": "Creates the release post as a draft on wpsimplepay.com through your logged-in Chrome session: uploads the screenshots, sets the featured image and fills the SEO fields. Never publishes.",
      "gates": [
        "Confirm the screenshots and post details before anything is uploaded",
        "Log in to wpsimplepay.com in Chrome if needed"
      ],
      "requires": [
        "browser"
      ],
      "blockedUntil": [
        {
          "check": {
            "fileExists": "{releaseDir}/blog.html"
          },
          "reason": "Run Write marketing content first. blog.html does not exist yet."
        },
        {
          "check": {
            "any": [
              {
                "fileExists": "{releaseDir}/blog-{version}-featured-image.jpg"
              },
              {
                "fileExists": "{releaseDir}/blog-{version}-featured-image.jpeg"
              },
              {
                "fileExists": "{releaseDir}/blog-{version}-featured-image.png"
              },
              {
                "fileExists": "{releaseDir}/blog-{version}-featured-image.webp"
              }
            ]
          },
          "reason": "Run Write marketing content first. The featured image does not exist yet."
        },
        {
          "check": {
            "contentReview": "passed"
          },
          "reason": "Run Check marketing content first: it has to pass (no blockers, every warning fixed or dismissed) before anything leaves the repo."
        }
      ],
      "review": {
        "type": "file",
        "path": "{releaseDir}/blog.html",
        "label": "Preview blog post"
      }
    },
    {
      "id": "email-draft",
      "group": "publish",
      "title": "Draft email campaign",
      "prompt": "/wpsp-draft-email-campaign {version}",
      "summary": "Creates the release announcement as a draft campaign in Lindris through your logged-in Chrome session, with the newsletter, subject, preview text and sender. Never sends or schedules: it disables every send button in the page first, and saves with plain Save only. The console refuses any send, schedule or send-test click, any script that re-enables those buttons, and any write request from the page, with no way to approve them.",
      "gates": [
        "Approve the campaign before anything is created",
        "Log in to Lindris in Chrome if needed"
      ],
      "requires": [
        "browser"
      ],
      "forbid": [
        "browser-send",
        "browser-write"
      ],
      "blockedUntil": [
        {
          "check": {
            "fileExists": "{releaseDir}/newsletter.html"
          },
          "reason": "Run Write marketing content first. newsletter.html does not exist yet."
        },
        {
          "check": {
            "contentReview": "passed"
          },
          "reason": "Run Check marketing content first: it has to pass (no blockers, every warning fixed or dismissed) before anything leaves the repo."
        }
      ],
      "review": {
        "type": "file",
        "path": "{releaseDir}/newsletter.html",
        "label": "Preview newsletter"
      }
    },
    {
      "id": "notifications-draft",
      "group": "publish",
      "title": "Draft in-plugin notifications",
      "prompt": "/wpsp-draft-notifications {version}",
      "summary": "Creates the Pro and Lite in-plugin notifications as drafts on plugin.wpsimplepay.com through your logged-in Chrome session, with the right licenses, buttons and dates. Never publishes: it removes the Publish button from the page before filling anything, and saves with Save Draft only.",
      "gates": [
        "Approve both notifications before anything is created",
        "Log in to plugin.wpsimplepay.com in Chrome if needed"
      ],
      "requires": [
        "browser"
      ],
      "blockedUntil": [
        {
          "check": {
            "fileExists": "{releaseDir}/notification-pro.html"
          },
          "reason": "Run Write marketing content first. notification-pro.html does not exist yet."
        },
        {
          "check": {
            "fileExists": "{releaseDir}/notification-lite.html"
          },
          "reason": "Run Write marketing content first. notification-lite.html does not exist yet."
        },
        {
          "check": {
            "contentReview": "passed"
          },
          "reason": "Run Check marketing content first: it has to pass (no blockers, every warning fixed or dismissed) before anything leaves the repo."
        }
      ],
      "review": {
        "type": "file",
        "path": "{releaseDir}/notification-pro.html",
        "label": "Preview notification copy"
      },
      "status": "wpsp-pro.hooks.mjs#notificationsDraft"
    },
    {
      "id": "notifications",
      "group": "publish",
      "title": "Preview in-plugin notifications",
      "prompt": "/wpsp-test-notifications {version}",
      "summary": "Imports the draft in-plugin notifications into the local site and shows the Lite and Pro variants in the admin, then cleans up.",
      "requires": [
        "browser",
        "local-wp"
      ],
      "review": {
        "type": "files",
        "label": "View notification drafts"
      }
    },
    {
      "id": "create-release",
      "group": "ship",
      "title": "Publish Pro release on GitHub",
      "prompt": "/wpsp-create-release {version}",
      "summary": "Tags the version on master and publishes the Pro GitHub release with the build attached. Checks the release PR has merged first. Permanent and public.",
      "gates": [
        "Confirm the tag and release notes before publishing"
      ],
      "irreversible": true,
      "requires": [
        "gh"
      ],
      "doneWhen": {
        "gitTag": "{version}"
      }
    },
    {
      "id": "lite-sync",
      "group": "ship",
      "title": "Sync release to Lite repo",
      "prompt": "/wpsp-lite-sync-release {version}",
      "summary": "Copies the release from Pro’s build into the Lite checkout, commits it on Lite’s release branch and opens Lite’s release PR.",
      "gates": [
        "Confirm creating Lite’s release branch if it does not exist"
      ],
      "requires": [
        "gh"
      ],
      "doneWhen": {
        "fileMatches": "{litePath}/stripe-checkout.php",
        "regex": "^\\s*\\*?\\s*Version:\\s*{version}\\s*$"
      }
    },
    {
      "id": "lite-publish",
      "group": "ship",
      "title": "Publish Lite release on GitHub",
      "prompt": "/wpsp-lite-publish-release {version}",
      "summary": "After Lite’s release PR has merged: tags Lite’s master and publishes the public Lite GitHub release with its zip. Permanent and public.",
      "gates": [
        "Confirm before tagging and publishing"
      ],
      "irreversible": true,
      "requires": [
        "gh"
      ],
      "blockedUntil": [
        {
          "check": {
            "fileExists": "{litePath}/stripe-checkout.php"
          },
          "reason": "Run Sync release to Lite repo first. There is no Lite checkout at {litePath}."
        }
      ],
      "doneWhen": {
        "gitTag": "{version}",
        "repo": "{litePath}"
      },
      "status": "wpsp-pro.hooks.mjs#litePublish"
    },
    {
      "id": "lite-wporg",
      "group": "ship",
      "title": "Publish Lite to WordPress.org",
      "prompt": "/wpsp-lite-org-release {version}",
      "summary": "Stages Lite’s GitHub Release zip into the wp.org SVN trunk and reports what changed. After you approve, commits trunk and tags the version on plugins.svn.wordpress.org. Permanent and public: it ships to every Lite site.",
      "gates": [
        "Review the staged trunk, then reply to commit and tag",
        "Enter your wp.org SVN password in a terminal if it is not cached"
      ],
      "irreversible": true,
      "requires": [
        "svn"
      ],
      "status": "wpsp-pro.hooks.mjs#liteWporg"
    }
  ],
  "probes": {
    "liteRelease": {
      "type": "githubRelease",
      "repo": "awesomemotive/wp-simple-pay-lite",
      "tag": "{version}"
    },
    "notificationFeeds": {
      "type": "script",
      "hook": "wpsp-pro.hooks.mjs#notificationFeeds"
    },
    "docsSitePr": {
      "type": "script",
      "hook": "wpsp-pro.hooks.mjs#docsSitePrProbe"
    }
  },
  "checks": [
    {
      "id": "branch",
      "label": "Release branch",
      "type": "gitBranch",
      "expect": [
        "release/{version}",
        "hotfix/{version}"
      ],
      "stages": [
        "analyze"
      ],
      "stageName": "Analyze"
    },
    {
      "id": "previous-tag",
      "label": "Previous release",
      "type": "previousTag",
      "tagPattern": "^\\d+\\.\\d+\\.\\d+(\\.\\d+)?$",
      "stages": [
        "analyze"
      ],
      "stageName": "Analyze"
    },
    {
      "id": "working-tree",
      "label": "Working tree",
      "type": "workingTree"
    },
    {
      "id": "gh",
      "label": "GitHub CLI",
      "type": "command",
      "run": [
        "gh",
        "auth",
        "status"
      ],
      "capture": "account (\\S+)",
      "okDetail": "Logged in as {match}.",
      "okDetailFallback": "Logged in.",
      "failDetail": "Not logged in. Run `gh auth login`.",
      "missingDetail": "`gh` is not installed.",
      "stages": [
        "review-milestone",
        "compare-builds",
        "analyze",
        "docs-site-pr",
        "create-release",
        "lite-sync",
        "lite-publish",
        "lite-wporg"
      ]
    },
    {
      "id": "local-site",
      "label": "Local site",
      "type": "localWpSite",
      "path": "{repo}",
      "stages": [
        "notifications"
      ]
    },
    {
      "id": "wp-env",
      "label": "wp-env",
      "type": "dockerContainer",
      "namePattern": "wordpress-\\d+$",
      "okDetail": "Running.",
      "failDetail": "Not running. Docs screenshots need `npm run env:start`.",
      "dockerDownDetail": "Docker is not running. Docs screenshots need `npm run env:start`.",
      "stages": [
        "docs"
      ]
    },
    {
      "id": "node16",
      "label": "Node 16",
      "type": "dirEntry",
      "dir": "~/.nvm/versions/node",
      "prefix": "v16.",
      "okDetail": "{match} (for the plugin build).",
      "failDetail": "No Node 16 under {dir}. The plugin build before screenshots needs it.",
      "stages": [
        "docs"
      ]
    },
    {
      "id": "marketing-site",
      "label": "Marketing site",
      "type": "setting",
      "field": "marketingSitePath",
      "issueHint": " Set it in Settings.",
      "localWpSite": {
        "notFound": "The wpsp-docs folder is not inside a Local site, so the sync cannot reach its database.",
        "stopped": "{site} is stopped. Start it in Local before the docs sync."
      },
      "stages": [
        "docs"
      ]
    },
    {
      "id": "lite",
      "label": "Lite checkout",
      "type": "setting",
      "field": "liteRepoPath",
      "stages": [
        "lite-sync",
        "lite-publish",
        "lite-wporg"
      ]
    },
    {
      "id": "svn",
      "label": "Subversion",
      "type": "script",
      "hook": "wpsp-pro.hooks.mjs#svnCheck",
      "stages": [
        "lite-wporg"
      ]
    }
  ],
  "outputs": {
    "dir": "{releaseDir}",
    "docsDir": "docs-user",
    "groups": [
      {
        "id": "notes",
        "title": "Release notes",
        "match": [
          "^release\\.md$",
          "^\\d+\\.\\d+\\.\\d+\\.\\d+\\.md$",
          "^marketing-site-changes.*\\.md$"
        ],
        "main": [
          "^release\\.md$"
        ],
        "secondary": [
          "^\\d+\\.\\d+\\.\\d+\\.\\d+\\.md$"
        ]
      },
      {
        "id": "blog",
        "title": "Blog post",
        "mediaLabel": "Screenshots",
        "match": [
          "^blog\\.html$",
          "^blog/",
          "featured-image\\.[a-z]+$"
        ],
        "main": [
          "^blog\\.html$"
        ],
        "secondary": [
          "featured-image"
        ]
      },
      {
        "id": "newsletter",
        "title": "Newsletter",
        "match": [
          "^newsletter"
        ],
        "main": [
          "^newsletter\\.html$"
        ]
      },
      {
        "id": "social",
        "title": "Social posts",
        "match": [
          "^(twitter|linkedin)[^/]*\\.txt$"
        ],
        "secondary": [
          "-pro\\.txt$"
        ]
      },
      {
        "id": "slack",
        "title": "Slack",
        "match": [
          "^slack[^/]*\\.txt$"
        ],
        "secondary": [
          "-pro\\.txt$"
        ]
      },
      {
        "id": "notifications",
        "title": "In-plugin notifications",
        "match": [
          "^notification[^/]*\\.html$"
        ],
        "secondary": [
          "-pro\\.html$"
        ]
      },
      {
        "id": "reviews",
        "title": "Reviews",
        "match": [
          "^reviews/",
          "^marketing-review/"
        ],
        "main": [
          "^reviews/readme\\.md$"
        ]
      },
      {
        "id": "media",
        "title": "Other media",
        "match": []
      },
      {
        "id": "other",
        "title": "Other",
        "match": []
      }
    ],
    "fallback": {
      "image": "media",
      "other": "other"
    }
  },
  "reset": {
    "preselect": [
      "^(simple-pay\\.php|readme(-lite)?\\.txt|docs/releases/|docs/PRODUCT\\.md|docs-user/|tests/e2e/admin/docs/|languages/|src/|includes/|views/)"
    ],
    "protect": [
      ".claude/commands/wpsp-compare-builds.md",
      ".claude/commands/wpsp-review-milestone.md",
      ".claude/commands/wpsp-update-docs.md",
      ".claude/release.config.example.json",
      ".dockerignore",
      ".eslintignore",
      ".gitignore",
      "CLAUDE.md",
      "docs/release-console-plan.md",
      "gruntfile.js",
      "package.json"
    ],
    "hide": [
      "tools/release-console/"
    ]
  },
  "risk": {
    "messages": {
      "browser-write": "Sends a write request from your logged-in browser, for example to wpsimplepay.com.",
      "svn-commit": "Commits or tags on wp.org SVN. It ships to every Lite site with auto-updates on.",
      "browser-send": "Sends or schedules an email from your logged-in browser. A campaign goes to every subscribed contact and cannot be unsent.",
      "browser-publish": "Publishes a post from your logged-in browser. A published in-plugin notification goes to every WP Simple Pay site."
    },
    "extra": [
      {
        "rule": "docs-sync",
        "match": "\\bwpsp-docs\\s+sync\\b",
        "reason": "Writes docs into the marketing site database.",
        "before": "prune"
      },
      {
        "rule": "npm-build",
        "match": "\\bnpm\\s+run\\s+build(?![\\w:-])",
        "before": "npm-publish",
        "reason": "`npm run build` runs `grunt clean`, which deletes vendor/ and composer.lock and breaks the local site until `composer install`. `npx wp-scripts build` builds assets without that."
      }
    ],
    "alsoMatch": {
      "svn-commit": [
        "\\bsvn-commit\\.sh\\b"
      ]
    }
  },
  "build": {
    "script": "tools/release-console/scripts/build-plugin.sh",
    "artifacts": [
      {
        "kind": "pro",
        "label": "WP Simple Pay Pro",
        "match": "^wp-simple-pay-pro"
      },
      {
        "kind": "lite",
        "label": "WP Simple Pay Lite",
        "match": "^stripe"
      }
    ],
    "exclude": [
      "tools/"
    ],
    "ciWorkflow": "build-and-export.yml"
  },
  "contentReview": {
    "stage": "marketing-review",
    "fixStage": "marketing",
    "dir": "{releaseDir}",
    "reportDir": "{releaseDir}/marketing-review",
    "files": [
      {
        "id": "blog",
        "label": "Blog post",
        "path": "blog.html",
        "format": "html"
      },
      {
        "id": "newsletter",
        "label": "Newsletter",
        "path": "newsletter.html",
        "format": "html"
      },
      {
        "id": "twitter",
        "label": "X (Twitter)",
        "path": "twitter.txt",
        "format": "text"
      },
      {
        "id": "linkedin",
        "label": "LinkedIn",
        "path": "linkedin.txt",
        "format": "text"
      },
      {
        "id": "slack-pro",
        "label": "Slack (Pro)",
        "path": "slack-pro.txt",
        "format": "text"
      },
      {
        "id": "slack-lite",
        "label": "Slack (Lite)",
        "path": "slack-lite.txt",
        "format": "text"
      },
      {
        "id": "notification-pro",
        "label": "Notification (Pro)",
        "path": "notification-pro.html",
        "format": "html"
      },
      {
        "id": "notification-lite",
        "label": "Notification (Lite)",
        "path": "notification-lite.html",
        "format": "html"
      }
    ],
    "sources": [
      "{analysisFile}"
    ],
    "guides": {
      "blog": [
        ".claude/commands/wpsp-marketing-blog-announcement.md"
      ],
      "newsletter": [
        ".claude/commands/wpsp-marketing-newsletter.md"
      ],
      "twitter": [
        ".claude/commands/wpsp-marketing-twitter-announcement.md"
      ],
      "linkedin": [
        ".claude/commands/wpsp-marketing-linkedin-announcement.md"
      ],
      "slack-pro": [
        ".claude/commands/wpsp-marketing-slack-announcement.md"
      ],
      "slack-lite": [
        ".claude/commands/wpsp-marketing-slack-announcement.md"
      ],
      "notification-pro": [
        ".claude/commands/wpsp-marketing-internal-notification.md"
      ],
      "notification-lite": [
        ".claude/commands/wpsp-marketing-internal-notification.md"
      ]
    },
    "instructions": "WP Simple Pay comes as Pro (paid) and Lite (free, on WordPress.org). The newsletter goes to Lite and Pro customers together; the Slack and notification pieces come in a Pro and a Lite version. The blog post is published after this review, so its link not opening yet is expected.",
    "rules": [
      {
        "id": "placeholders",
        "label": "Placeholder left in",
        "level": "blocker",
        "files": [
          "*"
        ],
        "type": "forbid",
        "regex": "\\b(?:TODO|TBD|FIXME|XXX)\\b|[Ll]orem ipsum|\\[(?:[Ll]ink|LINK|URL|[Ii]nsert[^\\]]*)\\]|\\{{(?:version|title|link|url|date)\\}}",
        "message": "Draft placeholder \"{match}\" is still in the text.",
        "fix": "Replace it with the real text or link."
      },
      {
        "id": "merge-tags",
        "label": "Broken merge tag",
        "level": "blocker",
        "files": [
          "newsletter"
        ],
        "type": "forbid",
        "regex": "\\{{\\{{(?!\\s*(?:Contact|Account):[A-Za-z]+(?:\\|\\\"[^\\\"]*\\\")?\\s*\\}}\\}})",
        "message": "A merge tag isn't written the way Lindris reads it, so it would show as raw text.",
        "fix": "Use {{{{ Contact:firstName|\"there\" }}}} or {{{{ Account:FullAddress }}}}."
      },
      {
        "id": "version",
        "label": "Version missing",
        "level": "blocker",
        "files": [
          "blog",
          "newsletter",
          "slack-pro",
          "slack-lite"
        ],
        "type": "require",
        "regex": "{version}",
        "message": "The text never mentions version {version}.",
        "fix": "Name the version, as in earlier announcements."
      },
      {
        "id": "no-script",
        "label": "Script in HTML",
        "level": "blocker",
        "files": [
          "blog",
          "newsletter",
          "notification-pro",
          "notification-lite"
        ],
        "type": "forbid",
        "regex": "<script\\b|\\bon(?:click|load|error)\\s*=",
        "flags": "gim",
        "message": "The HTML has a script or event handler (\"{match}\"). Email clients and WordPress strip it.",
        "fix": "Remove it."
      },
      {
        "id": "subject",
        "label": "Subject line",
        "level": "blocker",
        "files": [
          "newsletter"
        ],
        "type": "require",
        "regex": "^\\s*Subject[^:\\n]*:\\s*\\S",
        "flags": "im",
        "message": "The newsletter has no subject line in its header comment.",
        "fix": "Add \"Subject line: …\" to the comment at the top."
      },
      {
        "id": "subject-length",
        "label": "Subject too long",
        "level": "warning",
        "files": [
          "newsletter"
        ],
        "type": "maxLength",
        "max": 70,
        "capture": "^\\s*Subject[^:\\n]*:\\s*(.+?)\\s*$",
        "flags": "im",
        "message": "The subject line is {length} characters; inboxes cut it off after about {limit}.",
        "fix": "Shorten it."
      },
      {
        "id": "preview",
        "label": "Preview text",
        "level": "warning",
        "files": [
          "newsletter"
        ],
        "type": "require",
        "regex": "^\\s*Preview[^:\\n]*:\\s*\\S",
        "flags": "im",
        "message": "The newsletter has no preview text in its header comment.",
        "fix": "Add \"Preview text: …\" to the comment at the top."
      },
      {
        "id": "preview-length",
        "label": "Preview text too long",
        "level": "warning",
        "files": [
          "newsletter"
        ],
        "type": "maxLength",
        "max": 140,
        "capture": "^\\s*Preview[^:\\n]*:\\s*(.+?)\\s*$",
        "flags": "im",
        "message": "The preview text is {length} characters; inboxes show about {limit}.",
        "fix": "Shorten it to one sentence."
      },
      {
        "id": "tweet-length",
        "label": "Tweet too long",
        "level": "blocker",
        "files": [
          "twitter"
        ],
        "type": "maxLength",
        "max": 280,
        "split": "^(?:===[^\\n]*===|---[^\\n]*---)\\s*$",
        "ignore": "^\\([^\\n]*\\b(?:char|length)[^\\n]*\\)\\s*$",
        "urlLength": 23,
        "message": "This tweet is {length} characters as X counts it (links count as 23); the limit is {limit}.",
        "fix": "Trim it, or move a point to the thread.",
        "flags": "im"
      },
      {
        "id": "linkedin-length",
        "label": "LinkedIn post too long",
        "level": "warning",
        "files": [
          "linkedin"
        ],
        "type": "maxLength",
        "max": 3000,
        "message": "The post is {length} characters; LinkedIn allows {limit}.",
        "fix": "Cut it down; 1,000 to 1,500 reads best."
      },
      {
        "id": "tier-tags",
        "label": "Inline plan tag",
        "level": "warning",
        "files": [
          "newsletter",
          "blog"
        ],
        "type": "forbid",
        "regex": "\\((?:Pro|Plus|Professional|Elite)(?: plan)? only\\)|requires (?:a |the )?(?:Plus|Professional|Elite|Pro) (?:license|plan)",
        "flags": "gim",
        "message": "Feature copy names a plan (\"{match}\"). The newsletter guide says to keep plan talk to one upgrade block.",
        "fix": "Drop the tag; use the Pro upsell block if needed."
      },
      {
        "id": "notification-utm-pro",
        "label": "Link tracking",
        "level": "warning",
        "files": [
          "notification-pro"
        ],
        "type": "linkParams",
        "match": "^https?://(?:www\\.)?wpsimplepay\\.com",
        "params": {
          "utm_source": "WordPress",
          "utm_campaign": "pro-plugin",
          "utm_medium": "notification-inbox",
          "utm_content": ".+"
        },
        "message": "This link is missing or has the wrong {param}: {match}",
        "fix": "Add utm_source=WordPress&utm_campaign=pro-plugin&utm_medium=notification-inbox&utm_content=<the title>."
      },
      {
        "id": "notification-utm-lite",
        "label": "Link tracking",
        "level": "warning",
        "files": [
          "notification-lite"
        ],
        "type": "linkParams",
        "match": "^https?://(?:www\\.)?wpsimplepay\\.com",
        "params": {
          "utm_source": "WordPress",
          "utm_campaign": "lite-plugin",
          "utm_medium": "notification-inbox",
          "utm_content": ".+"
        },
        "message": "This link is missing or has the wrong {param}: {match}",
        "fix": "Add utm_source=WordPress&utm_campaign=lite-plugin&utm_medium=notification-inbox&utm_content=<the title>."
      },
      {
        "id": "notification-new-tab",
        "label": "Link opens in place",
        "level": "warning",
        "files": [
          "notification-pro",
          "notification-lite"
        ],
        "type": "linkAttrs",
        "attrs": {
          "target": "_blank",
          "rel": "noopener noreferrer"
        },
        "message": "A link lacks {attr}, so it would open inside the WordPress admin.",
        "fix": "Add target=\"_blank\" rel=\"noopener noreferrer\"."
      },
      {
        "id": "same-blog-link",
        "label": "Different blog links",
        "level": "warning",
        "files": [
          "*"
        ],
        "type": "sameLink",
        "match": "^https?://(?:www\\.)?wpsimplepay\\.com/introducing-",
        "message": "This links to {match}, but the other pieces link to {expected}.",
        "fix": "Use the same blog post link everywhere."
      },
      {
        "id": "images",
        "label": "Image",
        "level": "blocker",
        "files": [
          "blog",
          "newsletter"
        ],
        "type": "localImages",
        "maxBytes": 2097152,
        "message": "Image {match} is {size}{problem}.",
        "fix": "Add the image, or make it smaller (under 2 MB)."
      },
      {
        "id": "links-open",
        "label": "Dead link",
        "level": "warning",
        "files": [
          "*"
        ],
        "type": "linksOpen",
        "skip": "^https?://(?:www\\.)?wpsimplepay\\.com/introducing-|localhost|example\\.(?:com|org)|/wp-admin",
        "message": "{match} {problem}.",
        "fix": "Fix the link, or dismiss this if the page goes live with the release."
      }
    ]
  }
}
