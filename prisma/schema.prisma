generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Source {
  id            String      @id @default(cuid())
  type          String // "wordpress" | "github" | "upload"
  name          String
  config        String? // JSON: wordpress { url } · github { repo, branch, token }
  status        String      @default("connected") // connected | syncing | error
  enabled       Boolean     @default(true)
  lastSyncAt    DateTime?
  lastSyncError String? // why the last sync failed (cleared on success)
  syncInterval  String      @default("manual") // manual | hourly | daily | weekly
  nextSyncAt    DateTime? // when the scheduler should sync next (null = manual only)
  createdAt     DateTime    @default(now())
  documents     Document[]
  syncLogs      SyncLog[]
  importJobs    ImportJob[]

  @@index([nextSyncAt])
}

model ImportJob {
  id        String   @id @default(cuid())
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  kind      String   @default("import") // import | sync
  status    String   @default("running") // running | paused | cancelled | completed | error
  total     Int      @default(0)
  cursor    Int      @default(0) // index of the next item to process
  imported  Int      @default(0)
  proposed  Int      @default(0)
  skipped   Int      @default(0)
  failed    Int      @default(0)
  items      String? // JSON array of item refs to process
  current    String? // title of the item being processed
  error      String?
  trigger    String   @default("manual") // manual | schedule | retry
  retryOfId  String? // job this one is a retry of
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt // doubles as the runner heartbeat
  finishedAt DateTime?

  @@index([status, updatedAt])
  @@index([createdAt])
}

model Document {
  id         String     @id @default(cuid())
  sourceId   String
  source     Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId String? // WP post id or upload filename
  title      String
  content    String // current indexed content (plain text)
  excerpt    String?
  url        String?
  kind       String     @default("doc") // post | page | pdf | docx | txt | md
  status     String     @default("indexed") // indexed | archived
  version    Int        @default(1)
  chunkCount Int        @default(0)
  verified   Boolean    @default(true)
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  proposals  Proposal[]
  versions   DocumentVersion[]
  projects   ProjectDocument[]

  @@unique([sourceId, externalId])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int // the version number this snapshot WAS (before it got replaced)
  title      String
  content    String
  origin     String   @default("edit") // edit | proposal | sync | restore
  createdAt  DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // source.connected | import.started | document.deleted | proposal.approved | setting.changed | …
  entityType String? // source | document | proposal | importJob | setting
  entityId   String?
  summary    String // human-readable one-liner
  detail     String? // JSON extras
  actor      String   @default("system") // user email or "system" (background jobs)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entityType, entityId])
}

model Proposal {
  id         String    @id @default(cuid())
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type       String    @default("update") // update | archive
  origin     String    @default("sync") // sync | assistant | manual
  reason     String?
  oldContent String
  newContent String
  newTitle   String?
  status     String    @default("pending") // pending | approved | rejected
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model SyncLog {
  id        String   @id @default(cuid())
  sourceId  String?
  source    Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  message   String
  level     String   @default("info") // info | warn | error
  createdAt DateTime @default(now())
}

model AskLog {
  id        String   @id @default(cuid())
  question  String
  answer    String?
  citations String? // JSON array of cited chunks
  mode      String   @default("ask") // ask | search
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model AiUsage {
  id           String   @id @default(cuid())
  provider     String // groq | openai | anthropic | deepseek
  model        String
  operation    String // ask | embed-ask | assistant-draft | inline-edit | messenger
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  estimated    Boolean  @default(false) // true when the provider didn't report usage and we estimated
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([provider, createdAt])
}

model Project {
  id          String            @id @default(cuid())
  name        String
  description String?
  status      String            @default("planning") // planning | active | on_hold | done
  dueDate     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tasks       ProjectTask[]
  documents   ProjectDocument[]
  notes       Note[]

  @@index([status])
}

/** A task: on a project's board, or standalone (projectId null) on the Tasks page. */
model ProjectTask {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    String? // email of the user it's assigned to (Supabase auth), or null
  createdBy   String? // email of the user who created it, or "system"
  title       String
  notes       String?
  status      String    @default("todo") // todo | doing | done
  priority    String    @default("medium") // low | medium | high
  dueDate     DateTime?
  position    Int       @default(0) // order within its status column
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status, position])
  @@index([assignee, status])
  @@index([status, dueDate])
}

/** Knowledge base documents a project references. */
model ProjectDocument {
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([projectId, documentId])
  @@index([documentId])
}

// ── Releases: laptop agents controlled from here ─────────────────────────

/** A machine running release-agent, paired with a one-time code. */
model ReleaseAgent {
  id           String           @id @default(cuid())
  name         String
  tokenHash    String           @unique // sha256 of the agent's bearer token
  capabilities String           @default("[]") // JSON: ["browser", "gh", …]
  repos        String           @default("[]") // JSON: [{ id, name, recipe, stages, groups }]
  version      String? // agent software version
  lastSeenAt   DateTime?
  createdAt    DateTime         @default(now())
}

model ReleasePairing {
  code      String    @id // short one-time code shown in the UI
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String
  createdAt DateTime  @default(now())
}

// ── Notes: personal notebooks, optionally shared with the team ───────────

/** A folder of notes. Folders belong to one user. */
model NoteFolder {
  id        String   @id @default(cuid())
  owner     String // email of the user it belongs to
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  notes     Note[]

  @@index([owner, position])
}

/**
 * A note: markdown, owned by one user. `shared` makes it readable and
 * editable by every signed-in user; only the owner can share, trash or
 * delete it.
 */
model Note {
  id          String        @id @default(cuid())
  owner       String // email of the user who created it
  title       String        @default("")
  content     String        @default("") // markdown
  folderId    String?
  folder      NoteFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags        String[]      @default([])
  pinned      Boolean       @default(false)
  shared      Boolean       @default(false)
  version     Int           @default(1)
  updatedBy   String? // email of the last person to edit it
  documentId  String? // its knowledge base copy, once published
  publishedAt DateTime? // when that copy was last refreshed
  archivedAt  DateTime?
  trashedAt   DateTime? // in the trash; purged after 30 days
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  versions    NoteVersion[]

  @@index([owner, updatedAt])
  @@index([shared, updatedAt])
  @@index([folderId])
  @@index([projectId])
}

/** An earlier state of a note, kept at most every few minutes while editing. */
model NoteVersion {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  version   Int // the version number this snapshot WAS
  title     String
  content   String
  editedBy  String?
  createdAt DateTime @default(now())

  @@unique([noteId, version])
  @@index([noteId, createdAt])
}
