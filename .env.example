# ── Nonaki — AI Knowledge Base ───────────────────────────────────
# Copy this file to .env and fill in your own credentials:
#   cp .env.example .env

# Supabase Postgres (Prisma) — Dashboard → Settings → Database → Connection string
# DATABASE_URL:  "Transaction" pooler (port 6543) — used by the app at runtime
# DIRECT_URL:    "Session" / direct connection (port 5432) — used by `prisma migrate`
DATABASE_URL="postgresql://postgres.abc123xyz:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.abc123xyz:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase Auth — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://abc123xyz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.AbCdEf..."

# Weaviate Cloud — vector database + built-in text2vec-weaviate embeddings.
# Create a free sandbox cluster at https://console.weaviate.cloud
WEAVIATE_URL="https://abc123xyz.c0.us-west3.gcp.weaviate.cloud"
WEAVIATE_API_KEY="AbCdEfGhIjKlMnOpQrStUvWxYz0123456789AbCd"

# ── AI providers — answers, drafting & inline edits ─────────────
# Set a key for each provider you want available; switch the ACTIVE provider
# on the Settings page. Model overrides are optional.

# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY="gsk_AbCdEfGhIjKlMnOpQrStUvWxYz0123456789AbCdEfGhIjKl"
# Any Groq model id — free-tier options include:
#   llama-3.3-70b-versatile (default) · llama-3.1-8b-instant · openai/gpt-oss-120b
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.1"

# Claude (Anthropic) — https://platform.claude.com
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-4-8"

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_MODEL="deepseek-v4-flash"

# Scheduler — shared secret protecting /api/cron/* (Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>" automatically once set in the project).
# Optional locally; strongly recommended in production.
CRON_SECRET="generate-a-long-random-string"

# Kill switch — set to "true" to block all data source importing (WordPress
# connect/import, GitHub connect/import, manual & scheduled re-sync, file
# uploads). Existing indexed content is unaffected.
DATA_SOURCE_DISABLED="false"
