_format_version: "3.0"
_transform: true

services:
  - name: auth-v1
    url: http://${AUTH_INTERNAL_HOST}:${AUTH_INTERNAL_PORT}
    routes:
      - name: auth-v1-route
        strip_path: true
        paths:
          - /auth/v1
    plugins:
      - name: cors
        config:
          origins:
            - "*"
          credentials: true
          headers:
            - Accept
            - Authorization
            - Content-Type
            - apikey
            - x-client-info
            - x-supabase-api-version
          methods:
            - GET
            - POST
            - PUT
            - DELETE
            - OPTIONS
